---
import TechLabel from '../os/TechLabel';
// ~/playground.fig: one Figma-style canvas where four cursors (four sides of me) build a card
// (lib/playground.ts). The title-bar toggle sets the pace: normal (default) or hyper speed.
// The toys live in ToysSection.astro, near the bottom of the page.
import { ember, tags } from '../../lib/palette';

const CURSORS = [
  { id: 'designer', color: ember['500'] },
  { id: 'researcher', color: tags.sky },
  { id: 'engineer', color: tags.teal },
  { id: 'founder', color: tags.violet },
];
const LAYERS = [
  { id: 'frame', label: 'hi-card', depth: 0 },
  { id: 'heading', label: 'Heading', depth: 1 },
  { id: 'body', label: 'Body', depth: 1 },
  { id: 'button', label: 'Button', depth: 1 },
];
---

<section id="playground" class="playground" aria-labelledby="playground-title">
  <header class="section-head">
    <div class="os-path-row"><TechLabel client:near text="~/playground.fig" tone="cream" /></div>
    <h2 id="playground-title" class="section-heading">I design in Figma before I code.</h2>
    <p class="section-lede">Here&rsquo;s what that looks like when all four of me are in the file.</p>
  </header>

  <div class="fig" data-pace-root>
    <div class="wp-bar fig-bar">
      <span class="wp-lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="wp-file">playground.fig</span>
      <div class="fig-pace" role="group" aria-label="Pace">
        <button type="button" data-pace="normal" aria-pressed="true">normal</button>
        <button type="button" data-pace="hyper" aria-pressed="false">hyper speed</button>
      </div>
    </div>

    <div data-fig data-pace="normal">

      <div class="fig-toolbar">
        <span class="fig-tools" aria-hidden="true">
          <span data-on>Move</span><span>Frame</span><span>Text</span><span>Comment</span>
        </span>
        <ul class="fig-people" aria-label="In this file: designer, researcher, engineer and founder">
          {
            CURSORS.map((c) => (
              <li style={`--c:${c.color}`} title={c.id} aria-hidden="true">
                {c.id[0].toUpperCase()}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="fig-body">
        <aside class="fig-panel fig-layers" aria-hidden="true">
          <p class="fig-panel-title">Layers</p>
          <ul>
            {
              LAYERS.map((l) => (
                <li data-layer={l.id} style={`--depth:${l.depth}`}>
                  {l.label}
                </li>
              ))
            }
          </ul>
        </aside>

        <!-- The canvas is a picture of the process; the caption below says what it shows. -->
        <div class="fig-canvas" data-canvas aria-hidden="true">
          <p class="fig-frame-label">Desktop / hi</p>
          <div class="fig-card" data-el="card">
            <p class="fig-h" data-el="heading">hi, I&rsquo;m Aryan</p>
            <p class="fig-p" data-el="body">I research, build and start things. This card was made by four of me.</p>
            <span class="fig-btn" data-el="button" data-filled>Say hi</span>
          </div>
          <div class="fig-select" data-select hidden><i></i><i></i><i></i><i></i></div>
          {
            CURSORS.map((c) => (
              <div class="fig-cursor" data-cursor={c.id} style={`--c:${c.color}`}>
                <svg viewBox="0 0 16 16" width="18" height="18">
                  <path d="M1 1l5.5 14 2-6 6-2z" />
                </svg>
                <span>{c.id}</span>
              </div>
            ))
          }
        </div>

        <aside class="fig-panel fig-props" aria-hidden="true">
          <p class="fig-panel-title">Design</p>
          <dl data-props>
            <dt>Frame</dt>
            <dd>hi-card</dd>
            <dt>Fill</dt>
            <dd>#F2EBDD</dd>
            <dt>Button</dt>
            <dd>#FF4A2B</dd>
          </dl>
        </aside>
      </div>

      <div class="fig-foot">
        <p class="fig-caption">
          Four cursors, one canvas: the designer draws a frame, the researcher writes the heading, the engineer writes
          the body and the founder adds a button.
        </p>
        <button type="button" class="fig-replay" data-replay hidden>Replay</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { initPlayground, type Pace } from '../../lib/playground';
  const fig = document.querySelector<HTMLElement>('[data-fig]');
  const root = document.querySelector<HTMLElement>('[data-pace-root]');
  if (fig && root) {
    const pg = initPlayground(fig);
    const buttons = [...root.querySelectorAll<HTMLButtonElement>('button[data-pace]')];
    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        pg.setPace(b.dataset.pace as Pace);
      }),
    );
  }
</script>
