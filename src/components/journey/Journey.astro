---
// ~/journey: how I got here, one chapter per step.
// The markup is a plain timeline. Outside Lite mode, journey.css stacks the chapters into one
// screen-high stage and lib/journey.ts pins it and scrubs through them as you scroll.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import tks from '../../assets/photos/TKS_Hackathon.jpg';
import joeyhelps from '../../assets/photos/joeyhelps/image013.jpg';
import youreka from '../../assets/photos/youreka/83B76B52-8185-4602-84E2-E349E2BDC824 (3).jpg';
import shad from '../../assets/photos/shad/IMG_3861.jpg';
import teded from '../../assets/photos/teded/IMG_8389.jpg';
import okamoto from '../../assets/photos/Okamoto.jpg';

type Chapter = {
  year: string;
  /** Present tense, one sentence or two. Facts only (see src/content/projects). */
  line: string;
  /** Project window to open. */
  project: string;
  photo?: { src: ImageMetadata; alt: string; file: string };
};

const chapters: Chapter[] = [
  {
    year: '2020',
    line: 'I join The Knowledge Society and start digging into AI and gene editing.',
    project: 'tks',
    photo: { src: tks, alt: 'A group selfie at my first TKS hackathon', file: 'hackathon.jpg' },
  },
  {
    year: '2022',
    line: 'I co-found JoeyHelps to match Gen Z with mental health professionals.',
    project: 'joeyhelps',
    photo: { src: joeyhelps, alt: 'The JoeyHelps team in front of the Google sign at the Google office', file: 'pitch-day.jpg' },
  },
  {
    year: '2023',
    line: 'Our Youreka team studies genes linked to PTSD and reaches the national finals.',
    project: 'youreka',
    photo: { src: youreka, alt: 'Presenting our research in front of a projected slide at regionals', file: 'regionals.jpg' },
  },
  {
    year: '2023',
    line: 'A month at SHAD, at Lakehead University. I MC the closing ceremony.',
    project: 'shad',
    photo: { src: shad, alt: 'My SHAD team in suits and dresses outside a brick building', file: 'shad-team.jpg' },
  },
  {
    year: '2024',
    line: 'I give a TED-Ed talk in Vancouver: Did Curiosity Actually Kill the Cat?',
    project: 'teded',
    photo: { src: teded, alt: 'Me on stage giving my TED-Ed talk, with my slide behind me', file: 'on-stage.jpg' },
  },
  {
    year: '2024',
    line: 'A summer in Dr. Okamoto’s lab at Mount Sinai, building an AI tool that tracks mice.',
    project: 'okamoto-lab',
    photo: { src: okamoto, alt: 'Me at a lab bench in a white coat and gloves', file: 'bench.jpg' },
  },
  {
    // TODO(aryan): a photo from Western (campus, Western AI or a WFN event).
    year: 'Now',
    line: 'Computer Science and Ivey HBA at Western. Building TruthLens with Western AI.',
    project: 'truthlens',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="journey" class="journey" aria-labelledby="journey-title">
  <div class="journey-stage" data-journey-stage>
    <header class="journey-head">
      <p class="os-path">~/journey</p>
      <h2 id="journey-title" class="journey-heading">How I got here</h2>
    </header>

    <ol class="journey-chapters">
      {
        chapters.map((c, i) => (
          <li class="chapter" data-chapter>
            <div class="chapter-text">
              <p class="chapter-mark">
                <span class="chapter-num">{pad(i + 1)}</span>
                <span class="chapter-year">{c.year}</span>
              </p>
              <p class="chapter-line" data-chapter-line>
                {c.line}
              </p>
              <a href={`/work/${c.project}/`} data-open-window={c.project} class="chapter-link" aria-haspopup="dialog">
                Open {c.project}.md
              </a>
            </div>
            {c.photo ? (
              <figure class="chapter-photo">
                <div class="wp-bar">
                  <span class="wp-lights" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="wp-file">{c.photo.file}</span>
                </div>
                <div class="chapter-photo-img" data-chapter-photo>
                  <Picture
                    src={c.photo.src}
                    alt={c.photo.alt}
                    widths={[480, 800, 1200]}
                    width={1200}
                    sizes="(max-width: 767px) 100vw, 55vw"
                    formats={['avif', 'webp']}
                    fallbackFormat="jpg"
                  />
                </div>
              </figure>
            ) : (
              <div class="chapter-photo chapter-here" aria-hidden="true">
                <pre>{`> whoami\naryan\n> pwd\n/western/cs+hba\n> _`}</pre>
              </div>
            )}
          </li>
        ))
      }
    </ol>

    <ol class="journey-rail" aria-hidden="true" data-journey-rail>
      {chapters.map((c, i) => <li data-active={i === 0 ? '' : undefined}>{c.year}</li>)}
    </ol>
  </div>
</section>

<script>
  import { isLite, onLiteChange } from '../../lib/device-tier';

  // GSAP only loads when the scene is going to run: not in Lite mode, and not until the
  // section is getting close.
  const section = document.getElementById('journey');
  let scene: { destroy: () => void } | null = null;
  let loading = false;

  async function start() {
    if (!section || scene || loading || isLite()) return;
    loading = true;
    const { createJourney } = await import('../../lib/journey');
    loading = false;
    if (!isLite() && !scene) scene = createJourney(section);
  }

  if (section) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        io.disconnect();
        void start();
      },
      { rootMargin: '1500px 0px' },
    );
    io.observe(section);

    onLiteChange(() => {
      if (isLite()) {
        scene?.destroy();
        scene = null;
      } else {
        void start();
      }
    });
  }
</script>
