---
import TechLabel from '../os/TechLabel';
// me.md: a short bio, a photo, skills as plain tags and a few honours.
// Facts from Aryan's resume, LinkedIn and his answers (see memory notes); nothing invented.
import { getImage, Picture } from 'astro:assets';
import portrait from '../../assets/photos/shad/IMG_3240.jpg';
import tks from '../../assets/photos/TKS_Hackathon.jpg';
import joeyhelps from '../../assets/photos/joeyhelps/image013.jpg';
import shad from '../../assets/photos/shad/IMG_3861.jpg';
import teded from '../../assets/photos/teded/IMG_8389.jpg';
import okamoto from '../../assets/photos/Okamoto.jpg';
import AboutDesk from './AboutDesk';

// Same photos and alt text as ~/journey.
const PHOTOS = [
  { src: teded, alt: 'Me on stage giving my TED-Ed talk, with my slide behind me', title: 'TED-Ed, 2024' },
  { src: okamoto, alt: 'Me at a lab bench in a white coat and gloves', title: 'Mount Sinai, 2024' },
  { src: shad, alt: 'My SHAD team in suits and dresses outside a brick building', title: 'SHAD, 2023' },
  { src: joeyhelps, alt: 'The JoeyHelps team in front of the Google sign at the Google office', title: 'JoeyHelps, 2022' },
  { src: tks, alt: 'A group selfie at my first TKS hackathon', title: 'TKS, 2020' },
];
const photos = await Promise.all(
  PHOTOS.map(async (p) => ({ ...p, src: (await getImage({ src: p.src, width: 640, format: 'webp' })).src })),
);
const badgePhoto = (await getImage({ src: portrait, width: 600, format: 'jpg' })).src;

const SKILLS: { group: string; items: string[] }[] = [
  { group: 'Code', items: ['Python', 'TypeScript', 'Java', 'SQL', 'Swift', 'R'] },
  { group: 'Build', items: ['React', 'FastAPI', 'Node.js', 'Flask', 'MongoDB', 'Docker'] },
  { group: 'Machine learning', items: ['PyTorch', 'Hugging Face', 'scikit-learn', 'OpenCV', 'SLEAP'] },
  { group: 'Product', items: ['Figma', 'User testing', 'Onboarding design', 'Partnerships', 'Pitching'] },
];

const HONOURS = [
  'Harvard Prize Book Award, one of three winners in the Greater Toronto Area (2024)',
  'Western Scholarship of Distinction',
  'Won two TKS hackathons',
  '3rd place, W5 Catalyst Case Competition (Manulife case)',
  'Best Delegate, OxfordMUN Canada (2024)',
  'JA Extra Mile Award (2023)',
];
---

<section id="about" class="about" aria-labelledby="about-title">
  <article class="me-window">
    <div class="wp-bar">
      <span class="wp-lights" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="wp-file">me.md</span>
    </div>

    <div class="me-body">
      <figure class="me-photo">
        <Picture
          src={portrait}
          alt="Aryan in a dark suit and tie, leaning against a wall"
          widths={[320, 520, 760]}
          width={760}
          sizes="(max-width: 767px) 100vw, 360px"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
        />
      </figure>

      <div class="me-text">
        <div class="os-path-row"><TechLabel client:visible text="~/me.md" tone="navy" /></div>
        <h2 id="about-title" class="section-heading me-heading">Hi, I&rsquo;m Aryan.</h2>

        <div class="me-prose">
          <p>
            I&rsquo;m studying Computer Science at Western University and business at the Ivey Business School, in the
            dual-degree program (class of 2029).
          </p>
          <p>
            I like problems where biology meets code. At Mount Sinai I built an AI tool that tracks mice for memory
            research. With Youreka I studied genes linked to PTSD. I&rsquo;ve written about CRISPR, base editing and
            phage biology along the way.
          </p>
          <p>
            I also like starting things. I co-founded JoeyHelps, which matched Gen Z with mental health professionals,
            and CraftNova, which helps Gen Z explore the skilled trades. Right now I&rsquo;m building TruthLens with
            Western AI and running events for the Western Founders Network.
          </p>
          <!-- TODO(aryan): one line on what you're looking for (e.g. internships in ...). -->
        </div>

        <div class="me-skills">
          {
            SKILLS.map((s) => (
              <div class="me-skill-row">
                <h3>{s.group}</h3>
                <ul class="work-tags">
                  {s.items.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="me-honours">
          <h3>Honours</h3>
          <ul>
            {HONOURS.map((h) => <li>{h}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </article>

  <AboutDesk client:visible portrait={badgePhoto} photos={photos} />
</section>
