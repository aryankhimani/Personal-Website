---
import Base from '../layouts/Base.astro';
---

<Base>
  <main class="grid min-h-dvh grid-rows-[1fr_auto] p-6 sm:p-10">
    <div class="self-end max-w-xl">
      <p class="text-sm text-muted">aryan.os / phase 0</p>
      <h1 class="mt-3 text-2xl text-chrome-4 sm:text-3xl">The desk is empty.</h1>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        Menu bar, dock and windows land in the next phase.
      </p>
    </div>
    <p class="mt-10 text-xs text-muted">
      <span class="text-accent">&gt;</span> ready<span class="cursor">_</span>
    </p>
  </main>
</Base>

<style>
  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
