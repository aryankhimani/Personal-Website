---
import Base from '../layouts/Base.astro';
import DesktopIcon from '../components/os/DesktopIcon';

// Sections still to be built. Each keeps its place on the page so the dock has somewhere to go.
const upcoming = [
  { id: 'work', file: '~/work', note: 'Featured projects and project folders.' },
  { id: 'journey', file: '~/journey', note: 'How I got here, chapter by chapter.' },
  { id: 'playground', file: '~/playground.fig', note: 'A live design canvas and a few toys.' },
  { id: 'writing', file: '~/writing', note: 'Articles, newsletters and talks.' },
  { id: 'contact', file: 'new_message.eml', note: 'How to reach me.' },
];
---

<Base>
  <section id="home" class="relative flex min-h-[calc(100dvh-var(--menubar-h))] flex-col p-4 sm:p-6">
    <h1 class="sr-only">Aryan Khimani</h1>
    <ul class="flex gap-1 sm:flex-col sm:gap-2">
      <li><DesktopIcon id="readme" client:idle /></li>
      <li><DesktopIcon id="about-this-site" client:idle /></li>
    </ul>
    <p class="mt-auto mb-24 max-w-sm text-sm leading-relaxed text-muted">
      Open readme.md to try the windows. The hero goes here next.
    </p>
  </section>

  {
    upcoming.map((s) => (
      <section id={s.id} class="min-h-[70dvh] border-t border-hairline px-4 py-16 sm:px-6">
        <h2 class="text-xl text-chrome-4">{s.file}</h2>
        <p class="mt-2 max-w-md text-sm leading-relaxed text-muted">{s.note} Not built yet.</p>
      </section>
    ))
  }
</Base>
