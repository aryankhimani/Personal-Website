---
// The colour board: scales, tokens, proportion, section rhythm and every contrast pair.
// A review page for Aryan. TODO(phase-6): delete this page (and public/colour-board/) before launch.
import Base from '../layouts/Base.astro';
import palette from '../data/palette.json';
import { contrast } from '../../scripts/oklch.mjs';

const { scales, tags, deep, oklch } = palette as unknown as {
  scales: Record<string, Record<string, string>>;
  tags: Record<string, string>;
  deep: string;
  oklch: Record<string, Record<string, number[]>>;
};
const S = scales;

const TOKENS: [string, string, string][] = [
  ['--color-desk', 'navy-950', 'The desk: page ground, Work, Writing, footer'],
  ['--color-desk-2', 'navy-900', 'Cards on navy, menus'],
  ['--color-desk-3', 'navy-800', 'Raised / hover on navy, borders'],
  ['--color-window', 'cream-100', 'Window bodies, reading surfaces, Journey'],
  ['--color-titlebar', 'cream-300', 'Window title bars'],
  ['--color-ink', 'navy-950', 'Text on cream'],
  ['--color-ink-2', 'navy-700', 'Secondary text on cream'],
  ['--color-chrome-3', 'cream-100', 'Body text on navy'],
  ['--color-chrome-4', 'cream-50', 'Headings on navy (the lightest colour)'],
  ['--color-muted', 'navy-300', 'Secondary text on navy'],
  ['--color-accent', 'ember-500', 'CTA, focus, ticker, Contact'],
  ['--color-accent-ink', 'ember-700', 'Ember text on cream'],
];
const hex = (ref: string) => {
  const [n, s] = ref.split('-');
  return S[n][s];
};

type Pair = { fg: string; bg: string; use: string; large?: boolean; nonText?: boolean; avoid?: boolean };
const PAIRS: Pair[] = [
  { fg: 'cream-100', bg: 'navy-950', use: 'Body text on the desk' },
  { fg: 'cream-50', bg: 'navy-950', use: 'Headings on the desk' },
  { fg: 'navy-300', bg: 'navy-950', use: 'Secondary text on the desk' },
  { fg: 'cream-100', bg: 'navy-900', use: 'Text on cards and menus' },
  { fg: 'navy-300', bg: 'navy-900', use: 'Secondary text on cards' },
  { fg: 'navy-300', bg: 'navy-800', use: 'Secondary text on raised / hover' },
  { fg: 'navy-950', bg: 'cream-100', use: 'Text in windows and Journey' },
  { fg: 'navy-700', bg: 'cream-100', use: 'Secondary text in windows' },
  { fg: 'navy-800', bg: 'cream-100', use: 'Links in windows' },
  { fg: 'ember-700', bg: 'cream-100', use: 'Ember text on cream (years, labels)' },
  { fg: 'navy-950', bg: 'cream-300', use: 'Title bar text' },
  { fg: 'navy-950', bg: 'ember-500', use: 'CTA label, ticker, Contact text' },
  { fg: 'navy-900', bg: 'ember-500', use: 'Secondary text on Contact' },
  { fg: 'ember-300', bg: 'navy-950', use: 'Split-flap letters' },
  { fg: 'ember-500', bg: 'navy-950', use: 'Large ember text on navy', large: true },
  { fg: 'ember-500', bg: 'navy-950', use: 'Focus ring on navy (non-text, needs 3:1)', nonText: true },
  { fg: 'navy-800', bg: 'cream-100', use: 'Focus ring on cream (non-text, needs 3:1)', nonText: true },
  { fg: 'navy-950', bg: 'ember-500', use: 'Focus ring on Contact (non-text, needs 3:1)', nonText: true },
  { fg: 'ember-500', bg: 'cream-100', use: 'Small ember text on cream: not used, use ember-700', avoid: true },
  { fg: 'cream-50', bg: 'ember-500', use: 'Cream text on ember: not used, use navy', avoid: true },
];
const rows = PAIRS.map((p) => {
  const ratio = contrast(hex(p.fg), hex(p.bg));
  const need = p.nonText || p.large ? 3 : 4.5;
  return { ...p, ratio, pass: ratio >= need, need };
});

const RHYTHM: [string, string, string][] = [
  ['Hero', S.navy['950'], S.cream['50']],
  ['Ticker', S.ember['500'], S.navy['950']],
  ['Work', S.navy['950'], S.cream['50']],
  ['Journey', S.cream['100'], S.navy['950']],
  ['Memories', S.navy['950'], S.cream['50']],
  ['Playground', S.navy['950'], S.cream['50']],
  ['Writing', S.navy['950'], S.cream['50']],
  ['About', S.navy['950'], S.cream['50']],
  ['Contact', S.ember['500'], S.navy['950']],
  ['Footer', S.navy['950'], S.navy['300']],
];
const SCALE_NOTES: Record<string, string> = {
  navy: 'The desk. Hue 268 (OKLCH). Your #0B1430, #16224A, #2C3B6B and #A9B3CC are pinned at 950, 900, 800 and 300.',
  slate: 'Navy-tinted greys (same hue, chroma 0.004 to 0.026). Used where a grey is needed. There are no pure greys on the site.',
  ember: 'Red-orange, hue 32. #FF4A2B is 500 and #C2351B is 700. Chroma peaks at 500 and eases off at both ends.',
  cream: 'Warm cream, hue 85, very low chroma. #F2EBDD is 100. 50 is the lightest colour on the site (no #FFF).',
};
const fmt = (v: number[]) => `oklch(${v[0].toFixed(2)} ${v[1].toFixed(3)} ${Math.round(v[2])})`;
const passCount = rows.filter((r) => !r.avoid && r.pass).length;
const usedCount = rows.filter((r) => !r.avoid).length;
---

<Base title="Colour board — Aryan OS" noindex>
  <div class="cb">
    <header class="cb-head">
      <p class="os-path">~/colour.board</p>
      <h1 class="cb-title">Colour, as a system.</h1>
      <p class="cb-lede">
        Navy ground, cream surfaces, one ember accent. Every scale is built in OKLCH with a steady hue, every
        grey is tinted navy, and every text pair below passes WCAG AA. This page is for review and is removed
        before launch.
      </p>
    </header>

    <section class="cb-block" aria-labelledby="cb-prop">
      <h2 id="cb-prop" class="cb-h">60 · 30 · 10</h2>
      <div class="cb-bar" aria-hidden="true">
        <span style={`flex:60;background:${S.navy['950']};color:${S.cream['100']}`}>60% navy · grounds</span>
        <span style={`flex:30;background:${S.cream['100']};color:${S.navy['950']}`}>30% cream</span>
        <span style={`flex:10;background:${S.ember['500']};color:${S.navy['950']}`}>10%</span>
      </div>
      <div class="cb-demo" aria-label="Example screen">
        <div class="cb-demo-menubar"><b>Aryan OS</b> File View Work Help <i>TOR 09:41</i></div>
        <div class="cb-demo-desk">
          <div class="cb-demo-copy">
            <p class="cb-demo-path">~/home</p>
            <p class="cb-demo-name">Aryan Khimani</p>
            <p class="cb-demo-line">Body text is cream-100 on navy-950.</p>
            <p class="cb-demo-sub">Secondary text is navy-300.</p>
            <span class="cb-demo-cta">Open my work</span>
          </div>
          <div class="cb-demo-win">
            <div class="cb-demo-bar"><i></i><i></i><i></i><span>readme.md</span></div>
            <div class="cb-demo-body">
              <p><b>Cream window, navy ink.</b></p>
              <p class="cb-demo-ink2">Secondary text is navy-700. <span>Links are navy-800.</span></p>
              <p class="cb-demo-year">2024 · ember-700 on cream</p>
            </div>
          </div>
        </div>
        <div class="cb-demo-ticker">I DO · RESEARCH ◆ Python ◆ Western University ◆ PyTorch ◆</div>
      </div>
      <p class="cb-note">
        Ember shows up in at most three places per screen: the CTA, a focus or active state, and the ticker (or
        all of Contact). Glows use ember only, behind one focal element (the hero logo).
      </p>
    </section>

    <section class="cb-block" aria-labelledby="cb-scales">
      <h2 id="cb-scales" class="cb-h">Scales</h2>
      {
        Object.entries(S).map(([name, scale]) => (
          <div class="cb-scale">
            <div class="cb-scale-head">
              <h3>{name}</h3>
              <p>{SCALE_NOTES[name]}</p>
            </div>
            <ol class="cb-swatches">
              {Object.entries(scale).map(([step, h]) => (
                <li>
                  <span class="cb-chip" style={`background:${h}`} />
                  <b>{step}</b>
                  <code>{h}</code>
                  <small>{fmt(oklch[name][step])}</small>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
      <div class="cb-scale">
        <div class="cb-scale-head">
          <h3>extras</h3>
          <p>
            Desaturated hues for swarm-cursor name tags only, plus the one cross-hue gradient stop (navy to deep
            indigo).
          </p>
        </div>
        <ol class="cb-swatches">
          {
            Object.entries(tags).map(([k, h]) => (
              <li>
                <span class="cb-chip" style={`background:${h}`} />
                <b>{k}</b>
                <code>{h}</code>
              </li>
            ))
          }
          <li>
            <span class="cb-chip" style={`background:linear-gradient(90deg, ${S.navy['950']}, ${deep})`} />
            <b>deep</b>
            <code>{deep}</code>
          </li>
        </ol>
      </div>
    </section>

    <section class="cb-block" aria-labelledby="cb-tokens">
      <h2 id="cb-tokens" class="cb-h">Tokens</h2>
      <table class="cb-table">
        <thead><tr><th scope="col">Token</th><th scope="col">Value</th><th scope="col">Use</th></tr></thead>
        <tbody>
          {
            TOKENS.map(([t, ref, use]) => (
              <tr>
                <td><code>{t}</code></td>
                <td><span class="cb-dot" style={`background:${hex(ref)}`} /> {ref} <code>{hex(ref)}</code></td>
                <td>{use}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
      <p class="cb-note">
        Depth on navy comes from lightness steps (950 → 900 → 800), with a 1px top highlight on raised surfaces,
        not heavy shadows. Liquid metal and glass are a material, not a colour: they sit on top and pick up the
        navy or ember around them.
      </p>
    </section>

    <section class="cb-block" aria-labelledby="cb-rhythm">
      <h2 id="cb-rhythm" class="cb-h">Section rhythm</h2>
      <ol class="cb-rhythm">
        {RHYTHM.map(([n, bg, fg]) => <li style={`background:${bg};color:${fg}`}>{n}</li>)}
      </ol>
    </section>

    <section class="cb-block" aria-labelledby="cb-contrast">
      <h2 id="cb-contrast" class="cb-h">Contrast (WCAG 2.2 AA)</h2>
      <p class="cb-note">{passCount} of {usedCount} pairs in use pass. Text needs 4.5:1, large text and UI parts need 3:1.</p>
      <table class="cb-table">
        <thead>
          <tr><th scope="col">Sample</th><th scope="col">Pair</th><th scope="col">Ratio</th><th scope="col">AA</th><th scope="col">Where</th></tr>
        </thead>
        <tbody>
          {
            rows.map((r) => (
              <tr class:list={[r.avoid && 'cb-avoid']}>
                <td>
                  <span class="cb-sample" style={`background:${hex(r.bg)};color:${hex(r.fg)};${r.nonText ? `box-shadow:inset 0 0 0 3px ${hex(r.fg)}` : ''}`}>
                    {r.nonText ? '' : 'Aa'}
                  </span>
                </td>
                <td>{r.fg} on {r.bg}</td>
                <td>{r.ratio.toFixed(2)}:1</td>
                <td>{r.avoid ? 'not used' : r.pass ? `pass (≥${r.need})` : 'FAIL'}</td>
                <td>{r.use}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>

    <section class="cb-block" aria-labelledby="cb-shots">
      <h2 id="cb-shots" class="cb-h">Before and after</h2>
      <div class="cb-shots">
        <figure><img src="/colour-board/before-home.png" alt="The hero before: grey desk" loading="lazy" /><figcaption>Hero, before</figcaption></figure>
        <figure><img src="/colour-board/after-home.png" alt="The hero after: navy desk with the ember ticker" loading="lazy" /><figcaption>Hero, after</figcaption></figure>
        <figure><img src="/colour-board/before-work.png" alt="Work before: grey desk" loading="lazy" /><figcaption>Work, before</figcaption></figure>
        <figure><img src="/colour-board/after-work.png" alt="Work after: navy desk, cream cards" loading="lazy" /><figcaption>Work, after</figcaption></figure>
      </div>
    </section>
  </div>
</Base>

<style>
  .cb {
    --gutter: max(1rem, calc((100% - 72rem) / 2));
    padding: 4rem var(--gutter) 9rem;
    color: var(--color-chrome-3);
  }
  .cb-title {
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-variation-settings: 'wght' 300;
    line-height: 1;
    color: var(--color-chrome-4);
  }
  .cb-lede {
    max-width: 60ch;
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .cb-block {
    margin-top: 4rem;
  }
  .cb-h {
    margin-bottom: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-variation-settings: 'wght' 400;
    color: var(--color-chrome-4);
  }
  .cb-note {
    max-width: 70ch;
    margin-top: 1rem;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-muted);
  }
  .cb-bar {
    display: flex;
    height: 3rem;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    font-size: 0.75rem;
  }
  .cb-bar span {
    display: flex;
    align-items: center;
    padding: 0 0.75rem;
    white-space: nowrap;
    overflow: hidden;
  }
  .cb-demo {
    margin-top: 1.25rem;
    overflow: hidden;
    border-radius: 12px;
    background: var(--color-navy-950);
    box-shadow: inset 0 0 0 1px var(--color-hairline), var(--shadow-window);
  }
  .cb-demo-menubar {
    display: flex;
    gap: 1rem;
    padding: 0.5rem 1rem;
    background: var(--color-navy-900);
    box-shadow: inset 0 -1px 0 var(--color-hairline), var(--shadow-raised);
    font-size: 0.75rem;
  }
  .cb-demo-menubar b {
    color: var(--color-cream-50);
    font-weight: 400;
  }
  .cb-demo-menubar i {
    margin-left: auto;
    font-style: normal;
    color: var(--color-muted);
  }
  .cb-demo-desk {
    display: grid;
    gap: 2rem;
    padding: 2rem 1.5rem;
  }
  @media (min-width: 768px) {
    .cb-demo-desk {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 3rem;
    }
  }
  .cb-demo-path {
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .cb-demo-name {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-variation-settings: 'wght' 300;
    line-height: 1;
    color: var(--color-cream-50);
  }
  .cb-demo-line {
    margin-top: 0.75rem;
    font-family: var(--font-body);
    color: var(--color-cream-100);
  }
  .cb-demo-sub {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-navy-300);
  }
  .cb-demo-cta {
    display: inline-flex;
    margin-top: 1.25rem;
    padding: 0.625rem 1rem;
    border-radius: 8px;
    background: var(--color-ember-500);
    color: var(--color-navy-950);
    font-size: 0.875rem;
    box-shadow: 0 10px 24px -12px rgb(255 74 43 / 0.55);
  }
  .cb-demo-win {
    overflow: hidden;
    border-radius: 10px;
    background: var(--color-cream-100);
    color: var(--color-navy-950);
    box-shadow: var(--shadow-window);
  }
  .cb-demo-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 2rem;
    padding: 0 0.75rem;
    background: var(--color-cream-300);
    font-size: 0.75rem;
  }
  .cb-demo-bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-cream-400);
  }
  .cb-demo-bar span {
    margin: 0 auto;
    padding-right: 40px;
  }
  .cb-demo-body {
    display: grid;
    gap: 0.5rem;
    padding: 1.25rem;
    font-family: var(--font-body);
  }
  .cb-demo-ink2 {
    color: var(--color-navy-700);
  }
  .cb-demo-ink2 span {
    color: var(--color-navy-800);
    text-decoration: underline;
  }
  .cb-demo-year {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-ember-700);
  }
  .cb-demo-ticker {
    padding: 0.75rem 1rem;
    overflow: hidden;
    white-space: nowrap;
    background: var(--color-ember-500);
    color: var(--color-navy-950);
    font-size: 0.8125rem;
  }
  .cb-scale {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .cb-scale-head h3 {
    font-size: 1rem;
    color: var(--color-chrome-4);
  }
  .cb-scale-head p {
    max-width: 70ch;
    margin-top: 0.25rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .cb-swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(5.5rem, 1fr));
    gap: 0.5rem;
  }
  .cb-swatches li {
    display: grid;
    gap: 0.125rem;
    font-size: 0.6875rem;
  }
  .cb-swatches b {
    font-weight: 400;
    color: var(--color-chrome-4);
  }
  .cb-swatches code,
  .cb-swatches small {
    color: var(--color-muted);
  }
  .cb-swatches small {
    font-size: 0.625rem;
  }
  .cb-chip {
    display: block;
    height: 3.5rem;
    margin-bottom: 0.375rem;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .cb-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
  }
  .cb-table th {
    padding: 0.5rem;
    text-align: left;
    font-weight: 400;
    color: var(--color-muted);
    border-bottom: 1px solid var(--color-hairline);
  }
  .cb-table td {
    padding: 0.5rem;
    border-bottom: 1px solid rgb(44 59 107 / 0.45);
    vertical-align: middle;
  }
  .cb-table code {
    color: var(--color-muted);
  }
  .cb-avoid td {
    opacity: 0.7;
  }
  .cb-dot {
    display: inline-block;
    width: 0.75rem;
    height: 0.75rem;
    margin-right: 0.25rem;
    border-radius: 50%;
    vertical-align: -1px;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.15);
  }
  .cb-sample {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 2rem;
    border-radius: 4px;
    font-family: var(--font-body);
    font-size: 0.9375rem;
  }
  .cb-rhythm {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(6rem, 1fr));
    overflow: hidden;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .cb-rhythm li {
    padding: 2.5rem 0.75rem 0.75rem;
    font-size: 0.75rem;
    box-shadow: inset 1px 0 0 rgb(44 59 107 / 0.5);
  }
  .cb-shots {
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 768px) {
    .cb-shots {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cb-shots img {
    width: 100%;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .cb-shots figcaption {
    margin-top: 0.375rem;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
</style>
